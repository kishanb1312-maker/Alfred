# ── Alfred — environment template ─────────────────────────────────────
# Copy this file to `.env` (or run `alfred set-secret <KEY>`). `.env` is gitignored.
#
# There is NO Claude API key here: your Claude Code session is the brain.

# ── Sending email (dedicated job-hunt Gmail, NOT your personal inbox) ──
# Enable 2-Step Verification on the Gmail, then create an App Password for "Mail".
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ── Email finder (optional; fill the one you use) ─────────────────────
HUNTER_API_KEY=
APOLLO_API_KEY=

# ── Browser ───────────────────────────────────────────────────────────
# LinkedIn, Indeed, Wellfound and portal applications run through Aside, in your own
# signed-in browser. No browser password ever goes here.
