# ── Job Application Agent — environment template ──────────────────────
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored and NEVER committed. Each user keeps their own.
#
# NOTE: This tool is Claude-Code-native — there is NO Claude API key here.
# Your Claude Code session is the brain. These tokens are only for the
# external services the agents talk to.

# ── Telegram (approval gate) ──────────────────────────────────────────
# Create a bot via @BotFather (~2 min) → name it "Alfred" → it gives you the token.
# (The @username must be unique and end in "bot", e.g. alfred_yourname_bot.)
# Get your chat ID by messaging the bot, then reading getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Email finder (choose ONE; fill the one you use) ───────────────────
# Hunter.io free tier ~25–50 lookups/mo, or Apollo.
HUNTER_API_KEY=
APOLLO_API_KEY=

# ── Sending email (dedicated job-hunt Gmail, NOT your personal inbox) ──
# Enable 2FA on the Gmail, then create an App Password for SMTP.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ── Notion ────────────────────────────────────────────────────────────
# Notion is normally reached via the Claude Code Notion MCP connector,
# so these may stay blank. Fill only if a script needs direct API access.
NOTION_API_KEY=
NOTION_DATABASE_ID=

# ── LinkedIn ──────────────────────────────────────────────────────────
# Handled by your real logged-in Chrome (Claude-in-Chrome) — do NOT put
# your LinkedIn password here. Left here only as a reminder.
# LINKEDIN_EMAIL=  (unused — login happens in the browser)
